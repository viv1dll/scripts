-- ||          АРХИТЕКТУРА "HTTP POLLING" (С РЕЖИМОМ SPAMMER)        ||
-- ===================================================================
local oldWait = wait
local function enableBypass()
    getgenv().wait = function(d, ...)
        d = d or 0.03
        if d <= 0.05 then
            return oldWait(0, ...)
        end
        return oldWait(d, ...)
    end
end

local targetGui, jobIdTextBox, joinButton
local isLoopActive = false
local lastAttemptedJobId = nil

local function attemptJoin(jobId)
    local start = os.clock()
    
    task.defer(function()
        pcall(function()
            jobIdTextBox.Text = jobId
            firesignal(jobIdTextBox.FocusLost)
            firesignal(joinButton.MouseButton1Click)
        end)
    end)
    
    local delta = os.clock() - start
    print(string.format("[Timer] Delay: %.10f seconds", delta))
    
    -- Спам-режим
    if Settings.Spammer then
        while Settings.Spammer and jobId == lastAttemptedJobId do
            start = os.clock()
            
            task.defer(function()
                pcall(function()
                    jobIdTextBox.Text = jobId
                    firesignal(jobIdTextBox.FocusLost)
                    firesignal(joinButton.MouseButton1Click)
                end)
            end)
            
            delta = os.clock() - start
	    print(string.format("[Timer] Delay: %.10f seconds", delta))
	    task.wait(0.1)
        end
    end
end

-- ===== MASTER LOOP СИСТЕМА =====
local function startMasterLoop()
    if isLoopActive then return end
    isLoopActive = true
    
    task.spawn(function()
        while isLoopActive do
            local url = string.format("http://127.0.0.1:5269/get_latest_job")
            
            local success, response = pcall(game.HttpGet, game, url)
            
            if success and response then
                local decodedSuccess, data = pcall(HttpService.JSONDecode, HttpService, response)
                if decodedSuccess and data and data.job_id then
                    local latestJobId = data.job_id
                    if latestJobId and latestJobId ~= lastAttemptedJobId then
                        lastAttemptedJobId = latestJobId
                        attemptJoin(lastAttemptedJobId)
                    end
                end
            end
            task.wait(0.05)
        end
    end)
end

local function stopMasterLoop()
    isLoopActive = false
    print("[MasterLoop] Stopped")
end

initializeGuiReferences()
enableBypass()
startMasterLoop()
