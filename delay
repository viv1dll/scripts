local HttpService = game:GetService("HttpService")
local targetGui, jobIdTextBox, joinButton
local function initializeGuiReferences()
    task.spawn(function()
        print("[DelayHub] Searching for target GUI...")
        for i = 1, 10 do
            targetGui = game.CoreGui:FindFirstChild("Steal a Brainot - Chilli Hub Premium")
            if targetGui then
                for _, descendant in ipairs(targetGui:GetDescendants()) do
                    if descendant:IsA("TextLabel") and descendant.Text == "Job-ID Input" and descendant.Parent then
                        jobIdTextBox = descendant.Parent:FindFirstChildOfClass("TextBox")
                    end
                    if descendant:IsA("TextLabel") and descendant.Text == "Join Job-ID" and descendant.Parent then
                        joinButton = descendant.Parent:FindFirstChildOfClass("ImageButton")
                    end
                end
            end
            if targetGui and jobIdTextBox and joinButton then
                print("[DelayHub] All GUI elements found!")
                return
            end
            task.wait(1)
        end
        warn("[DelayHub] Target GUI not found after 10 attempts.")
    end)
end
